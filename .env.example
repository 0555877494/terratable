# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Configuration (for payments)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_public_key_here

# App Configuration
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Email Configuration (optional)
VITE_EMAIL_SERVICE=sendgrid
VITE_EMAIL_API_KEY=your-sendgrid-api-key-here

# SMS Configuration (optional)
VITE_SMS_SERVICE=twilio
VITE_SMS_ACCOUNT_SID=your-twilio-account-sid
VITE_SMS_AUTH_TOKEN=your-twilio-auth-token
VITE_SMS_PHONE_NUMBER=your-twilio-phone-number

# Analytics (optional)
VITE_ANALYTICS_ID=your-analytics-id

# Feature Flags
VITE_ENABLE_LIVE_CHAT=true
VITE_ENABLE_REVIEWS=true
VITE_ENABLE_WISHLIST=true
VITE_ENABLE_LOYALTY=true
VITE_ENABLE_SUBSCRIPTIONS=true
